generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth & Users ──────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  FOREMAN
  CREW
}

model Employee {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?  @unique
  name         String
  role         Role     @default(CREW)
  passwordHash String   @map("password_hash")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  foremanOf             WorkOrder[]                @relation("Foreman")
  crewDetails           CrewDetail[]
  additionalCrewDetails AdditionalWorkCrewDetail[]
  punchRecords          PunchRecord[]

  @@map("employees")
}

// ── Customers ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?  @default("MI")
  zip       String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workOrders WorkOrder[]

  @@map("customers")
}

// ── Work Orders ───────────────────────────────────────────

enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
}

enum JobCategory {
  LANDSCAPE
  FALL_CLEANUP
  SPRING_CLEANUP
  SUBCONTRACTOR
  IN_HOUSE_REPAIR
  BED_MAINTENANCE
  SPRINKLER
  LIGHTING
  HARDSCAPE
  OTHER
}

enum DataSource {
  MANUAL
  ZOHO
  EXCEL_IMPORT
}

model WorkOrder {
  id               String          @id @default(cuid())
  workOrderNumber  String          @unique @map("wo_number")
  customerId       String          @map("customer_id")
  customer         Customer        @relation(fields: [customerId], references: [id])
  foremanId        String?         @map("foreman_id")
  foreman          Employee?       @relation("Foreman", fields: [foremanId], references: [id])
  jobType          String          @map("job_type")
  jobCategory      JobCategory     @default(OTHER) @map("job_category")
  projectStartDate DateTime?       @map("start_date")
  projectEndDate   DateTime?       @map("end_date")
  percentCompleted Decimal         @default(0) @db.Decimal(5, 2) @map("pct_complete")
  totalManHours    Decimal         @default(0) @db.Decimal(8, 2) @map("total_hours")
  notes            String?
  materialsNotUsed String?         @map("materials_not_used")
  status           WorkOrderStatus @default(DRAFT)

  // ── Job Costing: Estimates ──
  invoiceNumber      String?   @map("invoice_number")
  invoiceAmount      Decimal?  @db.Decimal(10, 2) @map("invoice_amount")
  estCrewWage        Decimal?  @db.Decimal(10, 2) @map("est_crew_wage")
  estHours           Decimal?  @db.Decimal(8, 2) @map("est_hours")
  estCrewTotal       Decimal?  @db.Decimal(10, 2) @map("est_crew_total")

  // ── Job Costing: Actuals ──
  crewWage           Decimal?  @db.Decimal(10, 2) @map("crew_wage")
  actualHours        Decimal?  @db.Decimal(8, 2) @map("actual_hours")
  crewTotal          Decimal?  @db.Decimal(10, 2) @map("crew_total")
  materialCost       Decimal?  @db.Decimal(10, 2) @map("material_cost")
  subCost            Decimal?  @db.Decimal(10, 2) @map("sub_cost")
  dumpCost           Decimal?  @db.Decimal(10, 2) @map("dump_cost")
  fuelCost           Decimal?  @db.Decimal(10, 2) @map("fuel_cost")

  // ── Job Costing: Totals ──
  totalDirectExpense   Decimal?  @db.Decimal(10, 2) @map("total_direct_expense")
  totalIndirectExpense Decimal?  @db.Decimal(10, 2) @map("total_indirect_expense")
  profit               Decimal?  @db.Decimal(10, 2) @map("profit")
  profitPercent        Decimal?  @db.Decimal(8, 4) @map("profit_pct")

  // ── Payment Tracking ──
  amountPaid         Decimal?  @db.Decimal(10, 2) @map("amount_paid")
  datePaid           DateTime? @map("date_paid")
  amountOwed         Decimal?  @db.Decimal(10, 2) @map("amount_owed")

  // ── Weekly Analysis (Estimated vs Actual Man Hours) ──
  estCrewSize        Int?      @map("est_crew_size")
  estTotalManHours   Decimal?  @db.Decimal(8, 2) @map("est_total_man_hours")
  actualTravelHours  Decimal?  @db.Decimal(8, 2) @map("actual_travel_hours")
  actualJobTime      Decimal?  @db.Decimal(8, 2) @map("actual_job_time")
  actualSetupUnload  Decimal?  @db.Decimal(8, 2) @map("actual_setup_unload")
  actualTotalManHours Decimal? @db.Decimal(8, 2) @map("actual_total_man_hours")

  // ── Metadata ──
  dataSource       DataSource  @default(MANUAL) @map("data_source")
  sourceFile       String?     @map("source_file")
  sourceYear       Int?        @map("source_year")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  timeEntries         TimeEntry[]
  payments            Payment[]
  photos              Photo[]
  machines            Machine[]
  crewDetails         CrewDetail[]
  debris              Debris[]
  weeding             Weeding[]
  hourlyWork          HourlyWork[]
  materials           Material[]
  outsourcedMaterials OutsourcedMaterial[]
  additionalWork      AdditionalWork[]
  crewWorkLogs        CrewWorkLog[]
  punchRecords        PunchRecord[]

  @@map("work_orders")
}

// ── Time Entries (Day/Times of Project) ───────────────────

model TimeEntry {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")

  @@map("time_entries")
}

// ── Payments ──────────────────────────────────────────────

model Payment {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date        DateTime
  checkNumber String?   @map("check_number")
  amount      Decimal   @db.Decimal(10, 2)

  @@map("payments")
}

// ── Photos (Before/After) ─────────────────────────────────

enum PhotoType {
  BEFORE
  AFTER
}

model Photo {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  type        PhotoType
  imagePath   String    @map("image_path")
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")

  @@map("photos")
}

// ── Machines ──────────────────────────────────────────────

model Machine {
  id                 String            @id @default(cuid())
  workOrderId        String            @map("wo_id")
  workOrder          WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vehicleInfo        String            @map("vehicle_info")
  hours              Decimal           @db.Decimal(6, 2)
  machineInventoryId String?           @map("machine_inventory_id")
  machineInventory   MachineInventory? @relation(fields: [machineInventoryId], references: [id])

  @@map("machines")
}

// ── Crew Details ──────────────────────────────────────────

model CrewDetail {
  id            String    @id @default(cuid())
  workOrderId   String    @map("wo_id")
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date          DateTime
  employeeId    String?   @map("employee_id")
  employee      Employee? @relation(fields: [employeeId], references: [id])
  jobHours      Decimal   @default(0) @db.Decimal(6, 2) @map("job_hours")
  setupHours    Decimal   @default(0) @db.Decimal(6, 2) @map("setup_hours")
  travelHours   Decimal   @default(0) @db.Decimal(6, 2) @map("travel_hours")
  unloadHours   Decimal   @default(0) @db.Decimal(6, 2) @map("unload_hours")
  deliveryHours Decimal   @default(0) @db.Decimal(6, 2) @map("delivery_hours")

  @@map("crew_details")
}

// ── Debris ────────────────────────────────────────────────

model Debris {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date        DateTime
  amountYards Decimal   @db.Decimal(6, 2) @map("amount_yards")
  type        String?

  @@map("debris")
}

// ── Weeding / Bed Maintenance ─────────────────────────────

enum TimeUnit {
  HOURS
  MINUTES
}

model Weeding {
  id           String    @id @default(cuid())
  workOrderId  String    @map("wo_id")
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date         DateTime
  numEmployees Int       @map("num_employees")
  timeValue    Decimal   @db.Decimal(6, 2) @map("time_value")
  timeUnit     TimeUnit  @default(HOURS) @map("time_unit")

  @@map("weeding")
}

// ── Sprinkler / Landscape Lighting / Hourly Work ──────────

model HourlyWork {
  id           String    @id @default(cuid())
  workOrderId  String    @map("wo_id")
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  date         DateTime
  typeOfWork   String    @map("type_of_work")
  numEmployees Int       @map("num_employees")
  timeValue    Decimal   @db.Decimal(6, 2) @map("time_value")
  timeUnit     TimeUnit  @default(HOURS) @map("time_unit")

  @@map("hourly_work")
}

// ── MCC Materials ─────────────────────────────────────────

model Material {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  material    String
  qty         Decimal   @db.Decimal(10, 2)
  units       String?

  @@map("materials")
}

// ── Outsourced Materials ──────────────────────────────────

model OutsourcedMaterial {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  supplier    String
  material    String
  qty         Decimal   @db.Decimal(10, 2)
  unit        String?
  cost        Decimal?  @db.Decimal(10, 2)
  perUnitCost Decimal?  @db.Decimal(10, 2) @map("per_unit_cost")
  taxIncluded Boolean   @default(false) @map("tax_included")

  @@map("outsourced_materials")
}

// ── Snow Sites (fixed site list) ────────────────────────────

model SnowSite {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("snow_sites")
}

// ── Snow Rates (material/labor rate config) ─────────────────

model SnowRate {
  id                 String   @id @default(cuid())
  bulkSaltPerYard    Decimal  @default(0) @db.Decimal(10, 2) @map("bulk_salt_per_yard")
  iceMelterPerBag    Decimal  @default(0) @db.Decimal(10, 2) @map("ice_melter_per_bag")
  calciumPerBag      Decimal  @default(0) @db.Decimal(10, 2) @map("calcium_per_bag")
  employeePerHour    Decimal  @default(0) @db.Decimal(10, 2) @map("employee_per_hour")
  fuelPerHour        Decimal  @default(0) @db.Decimal(10, 2) @map("fuel_per_hour")
  indirectMultiplier Decimal  @default(0) @db.Decimal(5, 4) @map("indirect_multiplier")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("snow_rates")
}

// ── Snow Storm Events ───────────────────────────────────────

model SnowStorm {
  id              String   @id @default(cuid())
  description     String
  eventStart      DateTime @map("event_start")
  eventEnd        DateTime @map("event_end")
  masterTimeOnSite Decimal @default(0) @db.Decimal(8, 2) @map("master_time_on_site")
  fuelCost        Decimal  @default(0) @db.Decimal(10, 2) @map("fuel_cost")
  laborCost       Decimal  @default(0) @db.Decimal(10, 2) @map("labor_cost")
  subCost         Decimal  @default(0) @db.Decimal(10, 2) @map("sub_cost")
  indirectCost    Decimal  @default(0) @db.Decimal(10, 2) @map("indirect_cost")
  directCost      Decimal  @default(0) @db.Decimal(10, 2) @map("direct_cost")
  totalCost       Decimal  @default(0) @db.Decimal(10, 2) @map("total_cost")
  createdAt       DateTime @default(now()) @map("created_at")

  siteServices SnowSiteService[]

  @@map("snow_storms")
}

// ── Snow Site Services (per-site per-storm detail) ──────────

model SnowSiteService {
  id               String    @id @default(cuid())
  stormId          String?   @map("storm_id")
  storm            SnowStorm? @relation(fields: [stormId], references: [id], onDelete: Cascade)
  siteName         String    @map("site_name")
  startTime        DateTime  @map("start_time")
  endTime          DateTime  @map("end_time")
  servicesPerformed String   @map("services_performed")

  // Materials used
  bulkSaltYards    Decimal   @default(0) @db.Decimal(8, 2) @map("bulk_salt_yards")
  iceMelterBags    Decimal   @default(0) @db.Decimal(8, 2) @map("ice_melter_bags")
  calciumChlorideBags Decimal @default(0) @db.Decimal(8, 2) @map("calcium_chloride_bags")

  // Worker info
  workerName       String?   @map("worker_name")
  addedUser        String?   @map("added_user")

  // Counts
  plowCount        Int       @default(0) @map("plow_count")
  saltLotCount     Int       @default(0) @map("salt_lot_count")
  shovelCount      Int       @default(0) @map("shovel_count")
  saltWalkCount    Int       @default(0) @map("salt_walk_count")

  // Additional work
  additionalWorkRequested Boolean @default(false) @map("addl_work_requested")
  additionalWorkDesc      String? @map("addl_work_desc")

  // Costs
  totalDirect      Decimal   @default(0) @db.Decimal(10, 2) @map("total_direct")
  totalIndirect    Decimal   @default(0) @db.Decimal(10, 2) @map("total_indirect")
  employeeCost     Decimal   @default(0) @db.Decimal(10, 2) @map("employee_cost")
  subCost          Decimal   @default(0) @db.Decimal(10, 2) @map("sub_cost")
  siteNotes        String?   @map("site_notes")

  // Material costs
  bulkSaltCost     Decimal   @default(0) @db.Decimal(10, 2) @map("bulk_salt_cost")
  calciumCost      Decimal   @default(0) @db.Decimal(10, 2) @map("calcium_cost")
  fuelCost         Decimal   @default(0) @db.Decimal(10, 2) @map("fuel_cost")
  iceMelterCost    Decimal   @default(0) @db.Decimal(10, 2) @map("ice_melter_cost")

  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("snow_site_services")
}

// ── Landscape Materials (settings-managed fixed list) ──────

model LandscapeMaterial {
  id        String   @id @default(cuid())
  name      String   @unique
  unit      String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  logMaterials CrewWorkLogMaterial[]

  @@map("landscape_materials")
}

// ── Crew Work Logs (field entries linked to work orders) ────

model CrewWorkLog {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workType    String    @map("work_type")
  startTime   DateTime  @map("start_time")
  endTime     DateTime  @map("end_time")
  crewMembers Json      @map("crew_members")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  materials CrewWorkLogMaterial[]

  @@map("crew_work_logs")
}

model CrewWorkLogMaterial {
  id         String             @id @default(cuid())
  logId      String             @map("log_id")
  log        CrewWorkLog        @relation(fields: [logId], references: [id], onDelete: Cascade)
  materialId String             @map("material_id")
  material   LandscapeMaterial  @relation(fields: [materialId], references: [id])
  quantity   Decimal            @db.Decimal(10, 2)

  @@map("crew_work_log_materials")
}

// ── Approved / Additional Work ────────────────────────────

model AdditionalWork {
  id          String    @id @default(cuid())
  workOrderId String    @map("wo_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  number      Int?
  date        DateTime?
  status      String?
  typeOfWork  String?   @map("type_of_work")
  description String?

  crewDetails AdditionalWorkCrewDetail[]
  materials   AdditionalWorkMaterial[]

  @@map("additional_work")
}

model AdditionalWorkCrewDetail {
  id               String         @id @default(cuid())
  additionalWorkId String         @map("addl_work_id")
  additionalWork   AdditionalWork @relation(fields: [additionalWorkId], references: [id], onDelete: Cascade)
  number           Int?
  date             DateTime?
  employeeId       String?        @map("employee_id")
  employee         Employee?      @relation(fields: [employeeId], references: [id])
  jobHours         Decimal        @default(0) @db.Decimal(6, 2) @map("job_hours")
  deliveryHours    Decimal        @default(0) @db.Decimal(6, 2) @map("delivery_hours")

  @@map("additional_work_crew")
}

model AdditionalWorkMaterial {
  id               String         @id @default(cuid())
  additionalWorkId String         @map("addl_work_id")
  additionalWork   AdditionalWork @relation(fields: [additionalWorkId], references: [id], onDelete: Cascade)
  material         String
  qty              Decimal        @db.Decimal(10, 2)
  units            String?
  isOutsourced     Boolean        @default(false) @map("is_outsourced")
  supplier         String?
  cost             Decimal?       @db.Decimal(10, 2)
  perUnitCost      Decimal?       @db.Decimal(10, 2) @map("per_unit_cost")

  @@map("additional_work_materials")
}

// ── Punch In / Punch Out ──────────────────────────────────

enum ExtraType {
  DELIVERY
  SETUP
  UNLOAD
  OTHER
}

model PunchRecord {
  id          String       @id @default(cuid())
  employeeId  String       @map("employee_id")
  employee    Employee     @relation(fields: [employeeId], references: [id])
  workOrderId String?      @map("wo_id")
  workOrder   WorkOrder?   @relation(fields: [workOrderId], references: [id])
  punchIn     DateTime     @map("punch_in")
  punchOut    DateTime?    @map("punch_out")
  notes       String?
  extras      PunchExtra[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("punch_records")
}

model PunchExtra {
  id            String      @id @default(cuid())
  punchRecordId String      @map("punch_record_id")
  punchRecord   PunchRecord @relation(fields: [punchRecordId], references: [id], onDelete: Cascade)
  type          ExtraType
  hours         Decimal     @db.Decimal(5, 2)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("punch_extras")
}

// ── Machine Fleet / Maintenance ───────────────────────────

model MachineInventory {
  id                   String               @id @default(cuid())
  name                 String
  type                 String
  serialNumber         String?              @map("serial_number")
  serviceIntervalHours Decimal?             @db.Decimal(8, 2) @map("service_interval_hours")
  serviceIntervalDays  Int?                 @map("service_interval_days")
  lastServiceDate      DateTime?            @map("last_service_date")
  lastServiceHours     Decimal?             @db.Decimal(8, 2) @map("last_service_hours")
  notes                String?
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  jobMachines          Machine[]
  serviceLogs          MachineServiceLog[]

  @@map("machine_inventory")
}

model MachineServiceLog {
  id                 String           @id @default(cuid())
  machineInventoryId String           @map("machine_id")
  machine            MachineInventory @relation(fields: [machineInventoryId], references: [id], onDelete: Cascade)
  serviceDate        DateTime         @map("service_date")
  hoursAtService     Decimal?         @db.Decimal(8, 2) @map("hours_at_service")
  serviceType        String?          @map("service_type")
  notes              String?
  performedBy        String?          @map("performed_by")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@map("machine_service_logs")
}
